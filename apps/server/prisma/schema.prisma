// Event store schema (DESIGN.md §3 "PostgreSQL + Prisma", §4.1; docs/adr/0001-event-model.md).
//
// `events` is append-only: rows are never updated or deleted, and undo is a new
// compensating event (FR-REC-03). The per-room ordering guarantee (FR-SYNC-04) lives in
// the composite primary key below, not in application code — a duplicate seq is a
// constraint violation no matter which instance tried to write it.
//
//   npx prisma migrate dev --name init     # create/apply a migration
//   npx prisma generate                    # regenerate the client after a schema edit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id         String   @id @db.Uuid
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// GM device identity that created the room (ADR 0004). Null for rooms made before it existed.
  ownerGmId  String?  @map("owner_gm_id") @db.Uuid
  /// Denormalised from RoomCreated so the dashboard need not replay the log.
  name       String?

  owner       GmIdentity?  @relation(fields: [ownerGmId], references: [id])
  events      Event[]
  credentials Credential[]
  snapshots   Snapshot[]
  checkpoints Checkpoint[]
  assetRefs   AssetRef[]

  @@index([ownerGmId])
  @@map("rooms")
}

/// Interim GM identity until FR-GM-01 accounts (ADR 0004). Stores only the token's SHA-256.
model GmIdentity {
  id        String   @id @db.Uuid
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rooms  Room[]
  assets LibraryAsset[]

  @@map("gm_identities")
}

/// A GM's stored map or token image. `grid` is set for maps only.
model LibraryAsset {
  id        String   @id @db.Uuid
  ownerGmId String   @map("owner_gm_id") @db.Uuid
  kind      String
  objectKey String   @map("object_key")
  url       String
  name      String
  width     Int
  height    Int
  grid      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner GmIdentity @relation(fields: [ownerGmId], references: [id])

  @@index([ownerGmId, kind])
  @@map("library_assets")
}

/// Projection: which library assets a room's CURRENT state references (ADR 0004).
/// Derived from RoomState after each commit; never read back into it. No FK to
/// library_assets, and not a uuid column: the id arrives in a client command, so a room may
/// reference an id that is malformed or owned by someone else.
model AssetRef {
  assetId String @map("asset_id")
  roomId  String @map("room_id") @db.Uuid

  room Room @relation(fields: [roomId], references: [id])

  @@id([assetId, roomId])
  @@index([roomId])
  @@map("asset_refs")
}

model Event {
  roomId    String   @map("room_id") @db.Uuid
  seq       Int
  type      String
  payload   Json
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, seq])
  @@map("events")
}

model Credential {
  tokenHash     String    @id @map("token_hash")
  roomId        String    @map("room_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@map("credentials")
}

/// Periodic snapshots for fast room load; state at `seq`.
model Snapshot {
  roomId    String   @map("room_id") @db.Uuid
  seq       Int
  state     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, seq])
  @@map("snapshots")
}

/// Named checkpoints (FR-REC).
model Checkpoint {
  id        String   @id @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String
  seq       Int
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@map("checkpoints")
}
