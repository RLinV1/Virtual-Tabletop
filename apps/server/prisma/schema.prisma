// Event store schema (DESIGN.md §2 "PostgreSQL + Prisma", §5; docs/adr/0001-event-model.md).
//
// `events` is append-only: rows are never updated or deleted, and undo is a new
// compensating event (FR-REC-03). The one exception is deleting a whole room, which
// erases its log together with the room (docs/adr/0009-room-deletion.md). Postgres enforces
// this with triggers (migration 0007_events_insert_only, KAN-42). The per-room ordering guarantee (FR-SYNC-04) lives in
// the composite primary key below, not in application code — a duplicate seq is a
// constraint violation no matter which instance tried to write it.
//
//   npx prisma migrate dev --name init     # create/apply a migration
//   npx prisma generate                    # regenerate the client after a schema edit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id         String   @id @db.Uuid
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// GM device identity that created the room (ADR 0004). Null for rooms made before it existed.
  ownerGmId  String?  @map("owner_gm_id") @db.Uuid
  /// Denormalised from RoomCreated so the dashboard need not replay the log.
  name       String?

  owner       GmIdentity?  @relation(fields: [ownerGmId], references: [id])
  events      Event[]
  credentials Credential[]
  snapshots   Snapshot[]
  checkpoints Checkpoint[]
  assetRefs   AssetRef[]
  uploads     RoomUpload[]
  members     RoomMember[]

  @@index([ownerGmId])
  @@map("rooms")
}

/// An owner of rooms and library items (ADR 0004, ADR 0017). Despite the table name it now
/// holds two kinds of row: one per account (`users.owner_id`, no token), and legacy GM device
/// identities from before accounts, which store only their token's SHA-256. The device-identity
/// removal follow-up renames the table to `owners`.
model GmIdentity {
  id        String   @id @db.Uuid
  tokenHash String?  @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rooms     Room[]
  assets    LibraryAsset[]
  creatures LibraryCreature[]
  diceLooks DiceLook[]
  encounters EncounterTemplate[]
  user      User?

  @@map("gm_identities")
}

/// A person's account (FR-GM-01, ADR 0017). Never part of room state.
model User {
  id                String   @id @db.Uuid
  /// Trimmed and lowercased, so the unique index is case-insensitive.
  email             String   @unique
  displayName       String   @map("display_name")
  /// argon2id PHC string; never leaves the server.
  passwordHash      String   @map("password_hash")
  ownerId           String   @unique @map("owner_id") @db.Uuid
  activeDiceLookId  String?  @map("active_dice_look_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)

  owner          GmIdentity   @relation(fields: [ownerId], references: [id])
  activeDiceLook DiceLook?    @relation("ActiveDiceLook", fields: [activeDiceLookId], references: [id], onDelete: SetNull)
  sessions       Session[]
  memberships    RoomMember[]

  @@map("users")
}

/// A sign-in (ADR 0017 I1). Only the cookie token's SHA-256 is stored.
model Session {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute end: created_at + 90 days. Idle end is last_seen_at + 30 days.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id])
  credentials Credential[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Which participant a person is in a room (ADR 0017 M1). Access, not game state: kept beside
/// the event log like `credentials`, and never sent to any participant.
model RoomMember {
  roomId        String   @map("room_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([roomId, participantId])
  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_members")
}

/// A person's dice look (ADR 0017 O3): up to one picture per die type, in `faces`.
model DiceLook {
  id        String   @id @db.Uuid
  ownerGmId String   @map("owner_gm_id") @db.Uuid
  name      String
  /// { "d20": { "objectKey", "url", "width", "height" }, ... }; object keys never leave the server.
  faces     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner    GmIdentity @relation(fields: [ownerGmId], references: [id])
  activeOf User[]     @relation("ActiveDiceLook")

  @@index([ownerGmId])
  @@map("dice_looks")
}

/// A GM's stored map or token image. `grid` is set for maps only.
model LibraryAsset {
  id        String   @id @db.Uuid
  ownerGmId String   @map("owner_gm_id") @db.Uuid
  kind      String
  objectKey String   @map("object_key")
  url       String
  name      String
  width     Int
  height    Int
  grid      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner     GmIdentity        @relation(fields: [ownerGmId], references: [id])
  creatures LibraryCreature[]
  encounters EncounterTemplate[]

  @@index([ownerGmId, kind])
  @@map("library_assets")
}

/// A saved encounter board the GM reuses in new or existing rooms (docs/adr/0024-encounter-templates.md).
/// `data` is the validated EncounterTemplateData at `version`. Deleting its map clears `mapAssetId`;
/// the template stays but cannot be applied until the GM fixes it.
model EncounterTemplate {
  id         String   @id @db.Uuid
  ownerGmId  String   @map("owner_gm_id") @db.Uuid
  name       String
  version    Int
  data       Json
  mapAssetId String?  @map("map_asset_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner GmIdentity    @relation(fields: [ownerGmId], references: [id])
  map   LibraryAsset? @relation(fields: [mapAssetId], references: [id], onDelete: SetNull)

  @@index([ownerGmId])
  @@index([mapAssetId])
  @@map("encounter_templates")
}

/// A reusable creature the GM places from Add Token (docs/adr/0012-library-creatures.md).
/// Deleting its token art clears `imageAssetId`; the creature itself stays.
model LibraryCreature {
  id           String   @id @db.Uuid
  ownerGmId    String   @map("owner_gm_id") @db.Uuid
  name         String
  size         Float
  /// Starting HP; null preserves the legacy full-health default (KAN-70).
  hp           Int?
  /// Named to-hit/damage rolls copied into placed tokens (KAN-70).
  attacks      Json     @default("[]")
  maxHp        Int?     @map("max_hp")
  ac           Int?
  /// Disc colour for imageless tokens (KAN-70); null on rows from before it, read as the default.
  color        String?
  /// Conditions placed tokens start with (KAN-70).
  conditions   String[] @default([])
  imageAssetId String?  @map("image_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner GmIdentity    @relation(fields: [ownerGmId], references: [id])
  image LibraryAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([ownerGmId])
  @@index([imageAssetId])
  @@map("library_creatures")
}

/// Projection: which library assets a room's CURRENT state references (ADR 0004).
/// Derived from RoomState after each commit; never read back into it. No FK to
/// library_assets, and not a uuid column: the id arrives in a client command, so a room may
/// reference an id that is malformed or owned by someone else.
model AssetRef {
  assetId String @map("asset_id")
  roomId  String @map("room_id") @db.Uuid

  room Room @relation(fields: [roomId], references: [id])

  @@id([assetId, roomId])
  @@index([roomId])
  @@map("asset_refs")
}

/// Images uploaded from inside a room via /api/uploads, so deleting the room can remove
/// them (ADR 0009). Library uploads are `library_assets`, never listed here.
model RoomUpload {
  roomId    String @map("room_id") @db.Uuid
  objectKey String @map("object_key")

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, objectKey])
  @@index([roomId])
  @@map("room_uploads")
}

model Event {
  roomId    String   @map("room_id") @db.Uuid
  seq       Int
  type      String
  payload   Json
  actorId   String?  @map("actor_id") @db.Uuid
  /// One id per committed command batch, so undo reverses a command as a unit (ADR 0013).
  /// Null on events written before undo existed.
  commandId String?  @map("command_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, seq])
  @@map("events")
}

model Credential {
  tokenHash     String    @id @map("token_hash")
  roomId        String    @map("room_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// The sign-in this seat was created or kept under (ADR 0017 M4); it stops working with it.
  /// Null for guests who never signed in.
  sessionHash   String?   @map("session_hash")

  room    Room     @relation(fields: [roomId], references: [id])
  /// Restrict, not SET NULL: a seat must never outlive its sign-in as a guest seat. The store
  /// deletes a session's credentials itself, in the same transaction as the session.
  session Session? @relation(fields: [sessionHash], references: [tokenHash], onDelete: Restrict)

  @@index([sessionHash])
  @@map("credentials")
}

/// Periodic snapshots for fast room load; state at `seq`.
model Snapshot {
  roomId    String   @map("room_id") @db.Uuid
  seq       Int
  state     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, seq])
  @@map("snapshots")
}

/// Named checkpoints (FR-REC).
model Checkpoint {
  id        String   @id @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String
  seq       Int
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@map("checkpoints")
}
