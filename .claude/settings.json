{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm run --workspace:*)",
      "Bash(npm run dev)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
